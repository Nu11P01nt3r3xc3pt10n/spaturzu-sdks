{
  // Type-check the test/ directory alongside src/. Production build still
  // uses tsconfig.json (excludes test/). Vitest does its own transpilation
  // at test time; this config exists purely for static type-check via
  // pnpm typecheck.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*"]
}
