{
  "name": "@spaturzu/openclaw",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Superchiu Ltd",
  "type": "module",
  "description": "Spaturzu metering + budget hard-cap enforcement as an OpenClaw plugin.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "openclaw.plugin.json", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@spaturzu/sdk": "workspace:*",
    "uuid": "^11.0.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  },
  "sideEffects": false
}
